#!/usr/bin/env python3
"""Follow the journal and persist crashes that may involve the fault core.

The daemon creates one folder per incident under FAULTLAB_CRASH_DIR.  It
collects kernel crashes, machine-check events and coredumps that either name a
fault-core CPU or originate in faultlab.slice.  It never stores coredump
environment blocks or command lines.
"""
from __future__ import annotations

import argparse
import json
import logging
import os
import selectors
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Mapping

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "lib"))

from faultlab_crash import (  # noqa: E402
    Burst,
    CoredumpInfo,
    FaultContext,
    IncidentStore,
    SYSTEM_CRASH_DIR,
    Trigger,
    USER_CRASH_DIR,
    analyse_bootlog,
    backfill_qa_feed,
    build_capture_files,
    classify_kernel_line,
    cpu_text,
    cpus_in_text,
    field_str,
    iso,
    read_text,
    record_qa_feed,
    redact,
    run,
    static_incident,
    utc_now,
)

LOG = logging.getLogger("faultlab-crashd")
VERSION = "2.0"


def env_int(name: str, default: int) -> int:
    try:
        return int(os.environ.get(name, str(default)))
    except ValueError:
        return default


def env_float(name: str, default: float) -> float:
    try:
        return float(os.environ.get(name, str(default)))
    except ValueError:
        return default


def coredump_relevant(
    ctx: FaultContext, info: CoredumpInfo, collect_all: bool
) -> bool:
    if info.is_faultlab:
        return True
    if collect_all:
        return True
    if ctx.cpus_online() and info.allowed_cpus() & set(ctx.fault_cpus):
        return True
    return False


ATTRIBUTION_RANK = {"none": 0, "other-cpu": 1, "possible": 2, "direct": 3}
KIND_RANK = {
    "event": 0,
    "warning": 1,
    "thermal": 1,
    "segfault": 2,
    "coredump": 3,
    "lockup": 3,
    "mce": 4,
    "oops": 4,
    "panic": 5,
}
SEVERITY_RANK = {"info": 0, "warning": 1, "critical": 2}


class Manager:
    def __init__(
        self,
        ctx: FaultContext,
        store: IncidentStore,
        *,
        system: bool,
        burst_seconds: float,
        dedup_seconds: float,
        collect_all: bool,
    ) -> None:
        self.ctx = ctx
        self.store = store
        self.system = system
        self.burst_seconds = burst_seconds
        self.dedup_seconds = dedup_seconds
        self.collect_all = collect_all
        self.active: Burst | None = None
        self.last_event_ts = 0.0
        self.live = False
        self.started_at = utc_now()

    def feed(self, event: Mapping[str, Any]) -> None:
        message = field_str(event, "MESSAGE")
        if not message:
            return
        coredump = (
            CoredumpInfo.from_event(event) if "COREDUMP_PID" in event else None
        )
        trigger = classify_kernel_line(message)
        if coredump is None and trigger is None:
            if self.active is None:
                return
            if field_str(event, "_TRANSPORT") != "kernel":
                return
        ts = _event_ts(event)
        if ts > self.last_event_ts:
            self.last_event_ts = ts
        if ts >= utc_now() - 60:
            self.live = True
        boot_id = field_str(event, "_BOOT_ID")
        pid = _event_int(event, "_PID")
        comm = field_str(event, "_COMM")
        cgroup = field_str(event, "_SYSTEMD_CGROUP")
        unit = field_str(event, "_SYSTEMD_UNIT")
        if coredump is not None:
            if not coredump_relevant(self.ctx, coredump, self.collect_all):
                return
            self._ensure(boot_id, ts)
            assert self.active is not None
            self.active.add_coredump(coredump)
            if trigger is None:
                return
        if trigger is not None:
            self._ensure(boot_id, ts)
            assert self.active is not None
            self.active.add_trigger(
                trigger,
                message,
                ts,
                pid,
                comm,
                cgroup,
                unit,
                cpus_in_text(message),
            )
            return
        if (
            self.active is not None
            and self.active.boot_id == boot_id
            and ts - self.active.last_ts <= self.burst_seconds
        ):
            self.active.add_context(message, ts, pid, comm, cgroup, unit)

    def _ensure(self, boot_id: str, ts: float) -> None:
        if self.active is not None and (
            self.active.boot_id != boot_id
            or ts - self.active.last_ts > self.burst_seconds
        ):
            self.finalize()
        if self.active is None:
            self.active = Burst(boot_id=boot_id, first_ts=ts, last_ts=ts)

    def tick(self, now: float) -> None:
        if not self.live and now - self.started_at > 60:
            self.live = True
        reference = now if self.live else self.last_event_ts
        if (
            self.active is not None
            and reference - self.active.last_ts > self.burst_seconds
        ):
            self.finalize()

    def finalize(self) -> None:
        burst = self.active
        self.active = None
        if burst is None:
            return
        attribution = burst.attribution(self.ctx, self.collect_all)
        if not burst.should_store(attribution, self.collect_all):
            return
        record = burst.record(self.ctx, attribution)
        assert isinstance(record, dict)
        existing = self.store.recent(
            str(record.get("boot_id", "")),
            str(record.get("signature", "")),
            self.dedup_seconds,
        )
        if existing:
            self._merge(existing, record)
            return
        try:
            files = build_capture_files(
                self.ctx, record, burst.coredump, self.system
            )
            path = self.store.create(record, files)
        except Exception as exc:  # noqa: BLE001 - a bad capture must not stop collection
            LOG.error("could not store incident: %s", type(exc).__name__)
            return
        try:
            record = dict(record)
            record["id"] = path.name
            record_qa_feed(self.store, record, path, self.system)
        except OSError as exc:
            LOG.error("QA feed write failed: %s", exc.strerror or exc)
        LOG.info(
            "incident %s kind=%s attribution=%s cpus=%s",
            record.get("id"),
            record.get("kind"),
            attribution,
            record.get("matched_cpus"),
        )

    def _merge(self, existing: Mapping[str, Any], record: Mapping[str, Any]) -> None:
        directory = self.store.root / str(existing.get("dir", existing["id"]))
        incident_path = directory / "incident.json"
        try:
            incident = json.loads(read_text(incident_path))
        except ValueError:
            incident = dict(record)
        incident["occurrences"] = int(incident.get("occurrences", 1)) + 1
        incident["last_seen"] = record.get("last_seen", iso())
        incident["last_seen_ts"] = record.get("last_seen_ts", utc_now())
        if KIND_RANK.get(str(record.get("kind")), 0) > KIND_RANK.get(
            str(incident.get("kind")), 0
        ):
            incident["kind"] = record.get("kind")
        if SEVERITY_RANK.get(str(record.get("severity")), 0) > SEVERITY_RANK.get(
            str(incident.get("severity")), 0
        ):
            incident["severity"] = record.get("severity")
        if ATTRIBUTION_RANK.get(str(record.get("attribution")), 0) > (
            ATTRIBUTION_RANK.get(str(incident.get("attribution")), 0)
        ):
            incident["attribution"] = record.get("attribution")
        incident["matched_cpus"] = sorted(
            set(incident.get("matched_cpus") or [])
            | set(record.get("matched_cpus") or [])
        )
        incident["event_cpus"] = sorted(
            set(incident.get("event_cpus") or [])
            | set(record.get("event_cpus") or [])
        )
        occurrence = {
            "ts": record.get("last_seen"),
            "kind": record.get("kind"),
            "severity": record.get("severity"),
            "attribution": record.get("attribution"),
            "matched_cpus": record.get("matched_cpus"),
            "event_cpus": record.get("event_cpus"),
            "trigger_lines": record.get("trigger_lines", [])[:4],
        }
        try:
            self.store.append_occurrence(str(existing["id"]), occurrence)
            self.store.update(str(existing["id"]), incident)
            updated = json.loads(read_text(directory / "incident.json"))
        except Exception as exc:  # noqa: BLE001 - keep the collector alive
            LOG.error("could not update incident: %s", type(exc).__name__)
            return
        try:
            if isinstance(updated, dict):
                updated = dict(updated)
                updated["id"] = directory.name
                record_qa_feed(self.store, updated, directory, self.system)
        except OSError as exc:
            LOG.error("QA feed write failed: %s", exc.strerror or exc)
        LOG.info(
            "incident %s repeated (occurrences=%s)",
            existing.get("id"),
            incident["occurrences"],
        )


def _event_ts(event: Mapping[str, Any]) -> float:
    raw = field_str(event, "__REALTIME_TIMESTAMP")
    try:
        return int(raw) / 1_000_000
    except (TypeError, ValueError):
        return utc_now()


def _event_int(event: Mapping[str, Any], key: str) -> int | None:
    raw = field_str(event, key)
    try:
        return int(raw)
    except (TypeError, ValueError):
        return None


def journal_command(follow: bool, since: int) -> list[str]:
    cmd = [
        "journalctl",
        "--output=json",
        "--no-pager",
        "--since",
        f"-{since}s",
    ]
    if follow:
        cmd.append("--follow")
    return cmd


def scan_pstore(
    ctx: FaultContext, store: IncidentStore, system: bool
) -> None:
    root = Path("/var/lib/systemd/pstore")
    if not root.is_dir():
        return
    try:
        entries = sorted(root.iterdir())
    except OSError as exc:
        LOG.warning("pstore scan skipped: %s", exc.strerror or exc)
        return
    state = store.load_state("seen.json", {})
    seen = set(state.get("pstore") or [])
    changed = False
    for directory in entries:
        if not directory.is_dir() or directory.name in seen:
            continue
        text = ""
        for name in ("dmesg.txt",):
            candidate = directory / name
            if candidate.is_file() and not candidate.is_symlink():
                text = read_text(candidate, limit=2 * 1024 * 1024)
                break
        if not text:
            for candidate in sorted(directory.glob("dmesg-*")):
                if candidate.is_symlink():
                    continue
                text = read_text(candidate, limit=2 * 1024 * 1024)
                if text:
                    break
        if not text:
            seen.add(directory.name)
            changed = True
            continue
        result = analyse_bootlog(text)
        if result is None:
            seen.add(directory.name)
            changed = True
            continue
        trigger, cpus, excerpt, message = result
        if not (cpus & set(ctx.fault_cpus) or trigger.kind == "panic"):
            seen.add(directory.name)
            changed = True
            continue
        if any(
            row.get("boot_id") == f"pstore:{directory.name}"
            for row in store.read_index()
        ):
            seen.add(directory.name)
            changed = True
            continue
        try:
            created = int(directory.name) * 10
            if created < 1_000_000_000:
                created = directory.stat().st_mtime
        except (ValueError, OSError):
            created = utc_now()
        payload = {
            "pstore.txt": redact(excerpt),
            "pstore-record.txt": (
                f"record: {directory}\n"
                f"imported: {iso(created)}\n"
                f"source: systemd-pstore\n"
            ),
        }
        try:
            path = static_incident(
                ctx,
                store,
                source="pstore",
                trigger=trigger,
                message=message,
                excerpt=excerpt,
                boot_id=f"pstore:{directory.name}",
                created_ts=created,
                files=payload,
                system=system,
            )
        except Exception as exc:  # noqa: BLE001 - keep scanning records
            LOG.error("could not store pstore incident: %s", type(exc).__name__)
            continue
        seen.add(directory.name)
        changed = True
        LOG.info("pstore incident %s from %s", path.name, directory.name)
    if changed:
        state["pstore"] = sorted(seen)
        store.save_state("seen.json", state)


def scan_kdump(
    ctx: FaultContext, store: IncidentStore, system: bool
) -> None:
    if not system:
        return
    root = Path("/var/crash")
    if not root.is_dir():
        return
    try:
        entries = sorted(root.iterdir())
    except OSError as exc:
        LOG.warning("kdump scan skipped: %s", exc.strerror or exc)
        return
    state = store.load_state("seen.json", {})
    seen = set(state.get("kdump") or [])
    changed = False
    for directory in entries:
        if not directory.is_dir():
            continue
        try:
            if directory.stat().st_uid != 0:
                continue
        except OSError:
            continue
        core = directory / "vmcore"
        dmesg = directory / "vmcore-dmesg.txt"
        if core.is_symlink() or dmesg.is_symlink():
            continue
        if not core.is_file() and not dmesg.is_file():
            continue
        try:
            mtime = directory.stat().st_mtime
        except OSError:
            mtime = utc_now()
        key = f"{directory}:{int(mtime)}"
        if key in seen:
            continue
        text = read_text(dmesg, limit=2 * 1024 * 1024) if dmesg.is_file() else ""
        result = analyse_bootlog(text) if text else None
        if result is None:
            trigger = None
            cpus: set[int] = set()
            excerpt = "(vmcore-dmesg unavailable)\n"
            message = "kdump vmcore"
        else:
            trigger, cpus, excerpt, message = result
        if trigger is None:
            # A vmcore without a decodable dmesg is still a system crash.
            trigger = Trigger("panic", "critical", "kdump-vmcore")
        if any(
            row.get("boot_id") == f"kdump:{directory.name}"
            for row in store.read_index()
        ):
            seen.add(key)
            changed = True
            continue
        try:
            size = core.stat().st_size if core.is_file() else 0
        except OSError:
            size = 0
        payload = {
            "vmcore-dmesg.txt": redact(excerpt),
            "kdump.txt": (
                f"vmcore: {core if core.is_file() else '(missing)'}\n"
                f"size: {size} bytes\n"
                f"inspect: sudo crash /usr/lib/debug/boot/vmlinux-$(uname -r) "
                f"{core}\n"
            ),
        }
        try:
            path = static_incident(
                ctx,
                store,
                source="kdump",
                trigger=trigger,
                message=message,
                excerpt=excerpt,
                boot_id=f"kdump:{directory.name}",
                created_ts=mtime,
                files=payload,
                system=system,
            )
        except Exception as exc:  # noqa: BLE001 - keep scanning records
            LOG.error("could not store kdump incident: %s", type(exc).__name__)
            continue
        seen.add(key)
        changed = True
        LOG.info("kdump incident %s from %s", path.name, directory.name)
    if changed:
        state["kdump"] = sorted(seen)
        store.save_state("seen.json", state)


def system_service_active() -> bool:
    rc, _out, _err = run(
        ["systemctl", "is-active", "--quiet", "faultlab-crashd.service"],
        timeout=5,
    )
    return rc == 0


def check_line(line: str, ctx: FaultContext) -> int:
    trigger = classify_kernel_line(line)
    cpus = cpus_in_text(line)
    matched = cpus & set(ctx.fault_cpus)
    if trigger is None:
        print(f"kind=event cpus={sorted(cpus)} matched={sorted(matched)}")
        return 1
    if matched:
        attribution = "direct"
    elif trigger.kind == "mce" and cpus:
        attribution = "other-cpu"
    elif trigger.kind in ("mce", "panic"):
        attribution = "possible"
    elif ctx.current_mode() == "lab" and trigger.kind in ("oops", "lockup"):
        attribution = "possible"
    else:
        attribution = "none"
    print(
        f"kind={trigger.kind} severity={trigger.severity} "
        f"reason={trigger.reason} cpus={sorted(cpus)} "
        f"matched={sorted(matched)} attribution={attribution} "
        f"fault_cpus={cpu_text(ctx.fault_cpus)}"
    )
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(
        description="Persist fault-core crashes under one folder per incident."
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--system", action="store_true", help="system-wide capture")
    mode.add_argument("--user", action="store_true", help="user-level capture")
    parser.add_argument("--dir", type=Path, help="crash store directory")
    parser.add_argument("--once", action="store_true", help="process backlog and exit")
    parser.add_argument(
        "--since", type=int, default=600, help="journal backfill seconds (default 600)"
    )
    parser.add_argument("--check-line", help="classify one kernel line and exit")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    args = parser.parse_args(argv)

    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s faultlab-crashd[%(process)d]: %(levelname)s %(message)s",
    )
    ctx = FaultContext.load()
    if args.check_line:
        return check_line(args.check_line, ctx)
    if not ctx.configured:
        LOG.warning("no FAULT_CPUS configured; only global crashes will be kept")
    system = bool(args.system or (os.geteuid() == 0 and not args.user))
    root = args.dir or Path(
        os.environ.get(
            "FAULTLAB_CRASH_DIR",
            str(SYSTEM_CRASH_DIR if system else USER_CRASH_DIR),
        )
    )
    store = IncidentStore(root, system=system)
    store.ensure()
    if args.user and system_service_active():
        LOG.info("system faultlab-crashd is active; user collector exiting")
        return 0

    keep = max(1, env_int("FAULTLAB_CRASH_KEEP", 100))
    max_mb = max(1, env_int("FAULTLAB_CRASH_MAX_MB", 2048))
    burst_seconds = max(1.0, env_float("FAULTLAB_CRASH_BURST_SECONDS", 15.0))
    dedup_seconds = max(0.0, env_float("FAULTLAB_CRASH_DEDUP_SECONDS", 300.0))
    collect_all = os.environ.get("FAULTLAB_CRASH_COLLECT_ALL", "0") == "1"
    scan_interval = max(30.0, env_float("FAULTLAB_CRASH_SCAN_SECONDS", 300.0))
    prune_interval = max(3600.0, env_float("FAULTLAB_CRASH_PRUNE_SECONDS", 86400.0))

    manager = Manager(
        ctx,
        store,
        system=system,
        burst_seconds=burst_seconds,
        dedup_seconds=dedup_seconds,
        collect_all=collect_all,
    )
    removed = []
    try:
        removed = store.prune(keep, max_mb)
    except Exception as exc:  # noqa: BLE001 - keep collecting if retention fails
        LOG.error("retention failed: %s", type(exc).__name__)
    if removed:
        LOG.info("retention removed %d old incident(s)", len(removed))
    for scan in (scan_pstore, scan_kdump):
        try:
            scan(ctx, store, system)
        except Exception as exc:  # noqa: BLE001 - keep collecting
            LOG.error("%s failed: %s", scan.__name__, type(exc).__name__)
    try:
        fed = backfill_qa_feed(store, system)
        if fed:
            LOG.info("QA feed backfilled %d incident(s)", fed)
    except Exception as exc:  # noqa: BLE001 - QA must not stop collection
        LOG.error("QA feed backfill failed: %s", type(exc).__name__)

    running = True

    def stop(_signum: int, _frame: Any) -> None:
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)

    LOG.info(
        "starting: dir=%s mode=%s fault_cpus=%s system=%s",
        root,
        ctx.current_mode(),
        cpu_text(ctx.fault_cpus) or "unconfigured",
        system,
    )
    next_scan = utc_now() + scan_interval
    next_prune = utc_now() + prune_interval
    next_heartbeat = 0.0
    next_system_check = utc_now() + 60
    while running:
        proc = subprocess.Popen(
            journal_command(follow=not args.once, since=args.since),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            errors="replace",
            bufsize=1,
        )
        selector = selectors.DefaultSelector()
        if proc.stdout is not None:
            selector.register(proc.stdout, selectors.EVENT_READ)
        try:
            while running:
                now = utc_now()
                for _key, _mask in selector.select(timeout=1.0):
                    line = proc.stdout.readline() if proc.stdout else ""
                    if not line:
                        break
                    try:
                        event = json.loads(line)
                    except ValueError:
                        continue
                    if not isinstance(event, dict):
                        continue
                    try:
                        manager.feed(event)
                    except Exception as exc:  # noqa: BLE001 - keep the collector alive
                        LOG.error("event processing failed: %s", type(exc).__name__)
                try:
                    manager.tick(now)
                except Exception as exc:  # noqa: BLE001 - keep the collector alive
                    LOG.error("burst finalize failed: %s", type(exc).__name__)
                if now >= next_heartbeat:
                    try:
                        store.heartbeat(
                            {
                                "system": system,
                                "dir": str(root),
                                "mode": ctx.current_mode(),
                                "fault_cpus": list(ctx.fault_cpus),
                                "collect_all": collect_all,
                            }
                        )
                    except OSError as exc:
                        LOG.error("heartbeat write failed: %s", exc.strerror or exc)
                    next_heartbeat = now + 30
                if now >= next_scan:
                    for scan in (scan_pstore, scan_kdump):
                        try:
                            scan(ctx, store, system)
                        except Exception as exc:  # noqa: BLE001 - keep collecting
                            LOG.error(
                                "%s failed: %s",
                                scan.__name__,
                                type(exc).__name__,
                            )
                    next_scan = now + scan_interval
                if now >= next_prune:
                    try:
                        removed = store.prune(keep, max_mb)
                    except Exception as exc:  # noqa: BLE001 - keep collecting
                        LOG.error("retention failed: %s", type(exc).__name__)
                        removed = []
                    if removed:
                        LOG.info("retention removed %d old incident(s)", len(removed))
                    next_prune = now + prune_interval
                if args.user and now >= next_system_check:
                    if system_service_active():
                        LOG.info("system faultlab-crashd became active; handing over")
                        running = False
                    next_system_check = now + 60
                if args.once and proc.poll() is not None:
                    running = False
        finally:
            selector.close()
            if proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()
        if args.once:
            break
        if running:
            LOG.warning("journalctl exited; restarting in 5s")
            time.sleep(5)
    try:
        manager.finalize()
    except Exception as exc:  # noqa: BLE001 - best effort at shutdown
        LOG.error("final flush failed: %s", type(exc).__name__)
    LOG.info("stopped")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
